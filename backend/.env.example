# Application Configuration
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COMPANY_NAME=Dayflow

# Database Configuration (PostgreSQL 18)
DATABASE_URL=postgresql://postgres:<YOUR_POSTGRES_PASSWORD>@localhost:5432/dayflow_hrms

# JWT Authentication
SECRET_KEY=change_this_to_a_secure_random_64_character_hex_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=8

# Groq LLM Configuration for Agents (Optional)
GROQ_API_KEY=
GROQ_MODEL=llama3-8b-8192
